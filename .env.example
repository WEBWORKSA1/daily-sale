# daily.sale — environment variables (set in Vercel → Project → Settings → Environment Variables)
# Every variable is optional; the site works without them.

# --- Lead / form delivery (server-side only, never sent to the browser) ---
# Destination inbox for every form. If unset, a built-in default is used.
CONTACT_EMAIL=
# Formspree form id (e.g. xrgnpvqz). If set, forms deliver through Formspree first.
FORMSPREE_FORM_ID=
# Optional JSON webhook that also receives leads (Zapier, Make, Google Apps Script → Sheets, Slack…)
LEAD_WEBHOOK_URL=

# --- Monetization ---
# Numeric AdSense ad-unit id for in-content units. Leave blank to rely on Auto Ads only.
NEXT_PUBLIC_ADSENSE_SLOT=
# Instant donation checkout links (Stripe Payment Link, PayPal.me, Buy Me a Coffee…)
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_DONATE_MONTHLY_URL=

# --- Analytics / Search Console ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Optional on-demand revalidation secret for /api/refresh ---
REFRESH_SECRET=
